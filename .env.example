APP_NAME=Cinema Booking API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Use host "db" instead of "localhost" when the API runs in Docker Compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cinema_booking
DB_ECHO=false

# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=cinema_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
